<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TinyPix.App.Controls.TimelineEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- design: Timeline Editor — header, command bar, ruler, single track, time inputs. -->
    <UserControl.Resources>
        <Style x:Key="TimelineIconCommandStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource TinyPixControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="TimelineTextCommandStyle" TargetType="Button" BasedOn="{StaticResource TimelineIconCommandStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        Height="218"
        Background="{ThemeResource TinyPixSurfaceBrush}"
        BorderBrush="{ThemeResource TinyPixControlBorderBrush}"
        BorderThickness="1"
        CornerRadius="14"
        Padding="10">
        <Grid RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="30" />
                <RowDefinition Height="12" />
                <RowDefinition Height="86" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Timeline Header -->
            <Grid Grid.Row="0">
                <TextBlock
                    x:Name="HeaderText"
                    Text="非破坏单轨 · 1 段保留"
                    FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TinyPixInkBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="SummaryText"
                    Text="播放头 00:00.000 / 00:00.000"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource TinyPixMonoFontFamily}"
                    FontSize="9"
                    Foreground="{ThemeResource TinyPixMutedBrush}" />
            </Grid>

            <!-- Timeline CommandBar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5">
                <Button
                    x:Name="UndoButton"
                    Style="{StaticResource TimelineIconCommandStyle}"
                    Click="OnUndoClick"
                    ToolTipService.ToolTip="撤销"
                    AutomationProperties.Name="撤销">
                    <FontIcon Glyph="&#xE7A7;" FontSize="12" Foreground="{ThemeResource TinyPixInkBrush}" />
                </Button>
                <Button
                    x:Name="RedoButton"
                    Style="{StaticResource TimelineIconCommandStyle}"
                    Click="OnRedoClick"
                    ToolTipService.ToolTip="重做"
                    AutomationProperties.Name="重做">
                    <FontIcon Glyph="&#xE7A6;" FontSize="12" Foreground="{ThemeResource TinyPixInkBrush}" />
                </Button>
                <Button
                    Style="{StaticResource TimelineTextCommandStyle}"
                    Content="设入点"
                    Click="OnSetInClick"
                    AutomationProperties.Name="设置入点" />
                <Button
                    Style="{StaticResource TimelineTextCommandStyle}"
                    Content="设出点"
                    Click="OnSetOutClick"
                    AutomationProperties.Name="设置出点" />
                <Button
                    Style="{StaticResource TimelineTextCommandStyle}"
                    Click="OnSplitClick"
                    AutomationProperties.Name="在播放头处分割">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8C6;" FontSize="11" Foreground="{ThemeResource TinyPixInkBrush}" />
                        <TextBlock
                            Text="分割"
                            FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TinyPixInkBrush}" />
                    </StackPanel>
                </Button>
                <Button
                    Style="{StaticResource TimelineTextCommandStyle}"
                    Click="OnToggleSegmentClick"
                    AutomationProperties.Name="排除或恢复当前片段">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE738;" FontSize="11" Foreground="{ThemeResource TinyPixInkBrush}" />
                        <TextBlock
                            Text="排除/恢复"
                            FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TinyPixInkBrush}" />
                    </StackPanel>
                </Button>
                <Button
                    Style="{StaticResource TimelineIconCommandStyle}"
                    Margin="0"
                    HorizontalAlignment="Right"
                    Click="OnZoomOutClick"
                    ToolTipService.ToolTip="缩小"
                    AutomationProperties.Name="缩小时间轴">
                    <FontIcon Glyph="&#xE71F;" FontSize="12" Foreground="{ThemeResource TinyPixInkBrush}" />
                </Button>
                <Button
                    Style="{StaticResource TimelineIconCommandStyle}"
                    Click="OnZoomInClick"
                    ToolTipService.ToolTip="放大"
                    AutomationProperties.Name="放大时间轴">
                    <FontIcon Glyph="&#xE71E;" FontSize="12" Foreground="{ThemeResource TinyPixInkBrush}" />
                </Button>
            </StackPanel>

            <!-- Ruler -->
            <Grid Grid.Row="2" x:Name="RulerGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Ruler0" Grid.Column="0" Text="00:00" FontFamily="{ThemeResource TinyPixMonoFontFamily}" FontSize="8" Foreground="{ThemeResource TinyPixMutedBrush}" />
                <TextBlock x:Name="Ruler1" Grid.Column="1" Text="00:00" FontFamily="{ThemeResource TinyPixMonoFontFamily}" FontSize="8" Foreground="{ThemeResource TinyPixMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="Ruler2" Grid.Column="2" Text="00:00" FontFamily="{ThemeResource TinyPixMonoFontFamily}" FontSize="8" Foreground="{ThemeResource TinyPixMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="Ruler3" Grid.Column="3" Text="00:00" FontFamily="{ThemeResource TinyPixMonoFontFamily}" FontSize="8" Foreground="{ThemeResource TinyPixMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="Ruler4" Grid.Column="4" Text="00:00" FontFamily="{ThemeResource TinyPixMonoFontFamily}" FontSize="8" Foreground="{ThemeResource TinyPixMutedBrush}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Single Track -->
            <Border
                Grid.Row="3"
                Background="{ThemeResource TinyPixMediaStageBrush}"
                CornerRadius="8">
                <Canvas
                    x:Name="TrackCanvas"
                    Background="Transparent"
                    SizeChanged="OnTrackSizeChanged"
                    PointerPressed="OnTrackPointerPressed" />
            </Border>

            <!-- Timeline Time Inputs -->
            <Grid Grid.Row="4" ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource TinyPixSurfaceMutedBrush}" BorderBrush="{ThemeResource TinyPixControlBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="入点" FontFamily="{ThemeResource TinyPixCjkFontFamily}" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TinyPixMutedBrush}" />
                        <TextBlock x:Name="InPointText" Text="00:00.000" FontFamily="{ThemeResource TinyPixMonoFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TinyPixInkBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource TinyPixSurfaceMutedBrush}" BorderBrush="{ThemeResource TinyPixControlBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="播放头" FontFamily="{ThemeResource TinyPixCjkFontFamily}" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TinyPixMutedBrush}" />
                        <TextBlock x:Name="PlayheadText" Text="00:00.000" FontFamily="{ThemeResource TinyPixMonoFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TinyPixInkBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource TinyPixSurfaceMutedBrush}" BorderBrush="{ThemeResource TinyPixControlBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="出点" FontFamily="{ThemeResource TinyPixCjkFontFamily}" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TinyPixMutedBrush}" />
                        <TextBlock x:Name="OutPointText" Text="00:00.000" FontFamily="{ThemeResource TinyPixMonoFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TinyPixInkBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
