<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TinyPix.App.Controls.TaskQueueControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Shell/TaskQueue — design: 108 high, padding 12/18, gap 10. -->
    <Grid Padding="18,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    Text="任务队列"
                    Style="{StaticResource TinyPixSectionTitleStyle}"
                    VerticalAlignment="Center" />
                <Border
                    Width="22"
                    Height="22"
                    CornerRadius="11"
                    Background="{ThemeResource TinyPixLimeSoftBrush}">
                    <TextBlock
                        x:Name="QueueCountText"
                        Text="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource TinyPixUiFontFamily}"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TinyPixDeepLimeBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="全部展开" Style="{StaticResource TinyPixLabelStyle}" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE70E;" FontSize="11" Foreground="{ThemeResource TinyPixMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Task row -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource TinyPixSurfaceMutedBrush}"
            CornerRadius="12"
            Padding="12,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="30"
                    Height="28"
                    CornerRadius="7"
                    Background="{ThemeResource TinyPixInkBrush}"
                    VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource TinyPixLimeBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Width="330" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TaskTitleText"
                        Text="暂无进行中的任务"
                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TinyPixInkBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="TaskSubtitleText"
                        Text="开始处理后在此显示进度"
                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                        FontSize="9"
                        Foreground="{ThemeResource TinyPixMutedBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="2" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Height="5" VerticalAlignment="Center">
                        <Border Background="{ThemeResource TinyPixTrackBaseBrush}" CornerRadius="3" />
                        <Border
                            x:Name="ProgressFill"
                            Background="{ThemeResource TinyPixLimeBrush}"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="2" />
                    </Grid>
                    <TextBlock
                        x:Name="ProgressText"
                        Grid.Column="1"
                        Text="0%"
                        FontFamily="{ThemeResource TinyPixMonoFontFamily}"
                        FontSize="9"
                        Foreground="{ThemeResource TinyPixMutedBrush}"
                        VerticalAlignment="Center" />
                </Grid>

                <Button
                    x:Name="CancelButton"
                    Grid.Column="3"
                    Width="52"
                    Height="28"
                    Background="{ThemeResource TinyPixSurfaceBrush}"
                    BorderBrush="{ThemeResource TinyPixControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="0"
                    IsEnabled="False"
                    AutomationProperties.Name="取消任务">
                    <TextBlock
                        Text="取消"
                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                        FontSize="9"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TinyPixInkBrush}" />
                </Button>

                <Button Grid.Column="4" Style="{StaticResource TinyPixIconButtonStyle}" AutomationProperties.Name="任务操作">
                    <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="{ThemeResource TinyPixMutedBrush}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
