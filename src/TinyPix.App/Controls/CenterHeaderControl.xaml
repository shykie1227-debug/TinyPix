<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TinyPix.App.Controls.CenterHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- design: centerHeader → centerHeading (title 18/bold + sub 11/muted) + fitButton -->
    <Grid>
        <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource TinyPixPageTitleStyle}"
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource TinyPixPageSubtitleStyle}" />
        </StackPanel>

        <Button
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Height="36"
            Style="{StaticResource TinyPixSecondaryButtonStyle}"
            AutomationProperties.Name="适应窗口">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE740;" FontSize="12" Foreground="{ThemeResource TinyPixInkBrush}" />
                <TextBlock
                    Text="适应窗口"
                    FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TinyPixInkBrush}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
