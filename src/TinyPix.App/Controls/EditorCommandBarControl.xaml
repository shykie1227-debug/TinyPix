<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TinyPix.App.Controls.EditorCommandBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 25 CommandBar/Editor: native CommandBar with labeled commands and
         keyboard accelerators; overflow stays keyboard-accessible. -->
    <CommandBar
        x:Name="EditorBar"
        DefaultLabelPosition="Bottom"
        AutomationProperties.Name="编辑命令栏">
        <AppBarButton
            Label="撤销"
            Command="{Binding UndoCommand}"
            AutomationProperties.Name="撤销">
            <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
            <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="Z" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <AppBarButton
            Label="重做"
            Command="{Binding RedoCommand}"
            AutomationProperties.Name="重做">
            <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;" /></AppBarButton.Icon>
            <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="Y" Modifiers="Control" />
            </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <AppBarSeparator />
        <AppBarButton
            Label="旋转"
            Command="{Binding RotateCommand}"
            AutomationProperties.Name="旋转">
            <AppBarButton.Icon><FontIcon Glyph="&#xE7AD;" /></AppBarButton.Icon>
            <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="R" />
            </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <AppBarButton
            Label="适应窗口"
            Command="{Binding FitToWindowCommand}"
            AutomationProperties.Name="适应窗口">
            <AppBarButton.Icon><FontIcon Glyph="&#xE740;" /></AppBarButton.Icon>
            <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="F" />
            </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
        <AppBarButton
            Label="删除"
            Command="{Binding DeleteCommand}"
            AutomationProperties.Name="删除">
            <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
            <AppBarButton.KeyboardAccelerators>
                <KeyboardAccelerator Key="Delete" />
            </AppBarButton.KeyboardAccelerators>
        </AppBarButton>
    </CommandBar>
</UserControl>
