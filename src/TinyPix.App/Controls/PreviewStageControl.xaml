<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TinyPix.App.Controls.PreviewStageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- design: Video Preview Card (surface, r18, pad 14, shadow) → Stage (dark
         gradient, r12) with play circle + icon + timeline, then previewMeta row. -->
    <Grid AutomationProperties.Name="预览卡片">
        <Border
            x:Name="CardBorder"
            Height="356"
            Background="{ThemeResource TinyPixSurfaceBrush}"
            CornerRadius="18"
            Padding="14"
            VerticalAlignment="Top">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    CornerRadius="12"
                    Padding="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Color="#2C2D33" Offset="0" />
                                <GradientStop Color="#0F1013" Offset="0.58" />
                                <GradientStop Color="#292B31" Offset="1" />
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- placeholder (play circle + category icon) -->
                        <StackPanel
                            x:Name="PlaceholderPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <Grid Width="68" Height="68" HorizontalAlignment="Center">
                                <Ellipse Fill="#1FFFFFFF" Stroke="#42FFFFFF" StrokeThickness="1" />
                                <FontIcon
                                    x:Name="StageGlyph"
                                    Glyph="&#xE768;"
                                    FontSize="22"
                                    Foreground="{ThemeResource TinyPixLimeBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- page-provided preview (real thumbnail / frame) -->
                        <ContentPresenter x:Name="StageContentHost" />

                        <!-- timeline -->
                        <StackPanel
                            x:Name="TimelinePanel"
                            VerticalAlignment="Bottom"
                            Spacing="6">
                            <Grid Height="13" VerticalAlignment="Center">
                                <Border
                                    Height="3"
                                    CornerRadius="2"
                                    Background="#51525A"
                                    VerticalAlignment="Center" />
                                <Border
                                    Width="232"
                                    Height="3"
                                    CornerRadius="2"
                                    Background="{ThemeResource TinyPixLimeBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                                <Ellipse
                                    Width="13"
                                    Height="13"
                                    Fill="{ThemeResource TinyPixLimeBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="226,0,0,0" />
                            </Grid>
                            <Grid>
                                <TextBlock
                                    x:Name="TimeStartText"
                                    Text="00:00"
                                    FontFamily="{ThemeResource TinyPixMonoFontFamily}"
                                    FontSize="10"
                                    Foreground="{ThemeResource TinyPixOnMediaBrush}" />
                                <TextBlock
                                    x:Name="TimeEndText"
                                    Text="00:00"
                                    HorizontalAlignment="Right"
                                    FontFamily="{ThemeResource TinyPixMonoFontFamily}"
                                    FontSize="10"
                                    Foreground="{ThemeResource TinyPixOnMediaBrush}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <TextBlock
                        x:Name="PreviewNameText"
                        Text="尚未添加文件"
                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TinyPixInkBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="PreviewSpecText"
                        Text="添加文件后在此预览"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource TinyPixMonoFontFamily}"
                        FontSize="9"
                        Foreground="{ThemeResource TinyPixMutedBrush}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
