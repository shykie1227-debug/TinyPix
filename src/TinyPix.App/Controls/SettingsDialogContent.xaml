<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TinyPix.App.Controls.SettingsDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      The one reusable SettingsDialog content. Hosted by a ContentDialog on the
      app root XamlRoot, so the modal scrim covers the complete XamlRoot
      (top navigation included) per the frozen settings-dialog evidence.
      Standard width ~820 with a left category list.
    -->
    <Grid Width="820" MinHeight="488">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="SettingsCategoryList" Grid.Column="0" AutomationProperties.Name="设置分类">
            <ListViewItem Content="通用" IsSelected="True" />
            <ListViewItem Content="输出" />
            <ListViewItem Content="缓存" />
            <ListViewItem Content="离线引擎与许可证" />
        </ListView>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12" Padding="16">
                <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />

                <TextBox
                    x:Name="OutputDirectoryBox"
                    Header="输出目录"
                    Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}"
                    AutomationProperties.Name="输出目录" />

                <ComboBox
                    x:Name="ThemeBox"
                    Header="主题"
                    SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                    SelectedValuePath="Tag">
                    <ComboBoxItem Content="跟随系统" Tag="System" />
                    <ComboBoxItem Content="浅色" Tag="Light" />
                    <ComboBoxItem Content="深色" Tag="Dark" />
                </ComboBox>

                <ToggleSwitch
                    x:Name="ReduceMotionSwitch"
                    Header="减少动画"
                    IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}" />

                <ToggleSwitch
                    x:Name="ConfirmReplaceSwitch"
                    Header="覆盖已有输出前确认"
                    IsOn="{x:Bind ViewModel.ConfirmBeforeReplacingExistingOutput, Mode=TwoWay}" />

                <Button
                    x:Name="SaveSettingsButton"
                    Content="保存设置"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveSettingsCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
