<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <AssemblyName>TinyPix</AssemblyName>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TinyPix.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Self-contained: the framework DLLs ship beside the exe (multi-file) or in
         the single-file extraction directory. The bootstrapper (framework-dependent
         MSIX lookup) must stay OFF: with it on, the app shows the
         "Required components of the Windows App Runtime are missing
         (MSIX package version >= 2.1.3.0)" dialog because no runtime is installed.
         The self-contained path is WindowsAppSdkUndockedRegFreeWinRTInitialize below.
         Single-file additionally needs MICROSOFT_WINDOWSAPPRUNTIME_BASE_DIRECTORY
         to point at the extraction directory - see WindowsAppRuntimeBaseDirectory. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Default stays as-is: the formal release is still the portable folder.
         `-p:PublishSingleFile=true` switches the same project to the optional
         single-file TinyPix.exe. Windows App SDK requires
         IncludeAllContentForSelfExtract (plus unpackaged + self-contained,
         both already set above) or its `WindowsAppSDKSingleFileVerifyConfiguration`
         target fails the build. See build/Publish-SingleFile.ps1. -->
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TinyPix.Core/TinyPix.Core.csproj" />
    <ProjectReference Include="../TinyPix.Media/TinyPix.Media.csproj" />
    <ProjectReference Include="../TinyPix.Infrastructure/TinyPix.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Use the modular 2.2 packages; the full metapackage also pulls unused AI/ML/Widgets. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
  </ItemGroup>
</Project>
