<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TinyPix.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Formal TinyPix 4.0 shell, rebuilt from the Pencil design source with native
      WinUI controls (the Windows 10 feasibility-gate prototype is throwaway and
      must not be copied). Structure per design/WINUI-CONTROL-MAPPING.md:
      top category NavigationView + two-row/three-column four-region workbench.
    -->
    <Grid x:Name="ShellRoot">
        <NavigationView
            x:Name="CategoryNav"
            PaneDisplayMode="Top"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            AutomationProperties.Name="顶部分类"
            SelectionChanged="OnCategorySelectionChanged"
            ItemInvoked="OnCategoryItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="ImageCategoryItem"
                    Content="图片工具"
                    AutomationProperties.Name="图片工具"
                    Tag="image" />
                <NavigationViewItem
                    x:Name="VideoCategoryItem"
                    Content="视频工具"
                    AutomationProperties.Name="视频工具"
                    Tag="video" />
                <NavigationViewItem
                    x:Name="ToolboxCategoryItem"
                    Content="工具箱"
                    AutomationProperties.Name="工具箱"
                    Tag="toolbox" />
            </NavigationView.MenuItems>

            <!-- Four-region workbench: row 0 = file | workbench | parameters,
                 row 1 = task queue spanning all three columns. -->
            <Grid x:Name="WorkbenchGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="92" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="LeftFilePanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    AutomationProperties.Name="文件区域">
                    <StackPanel Spacing="8" Padding="12">
                        <TextBlock Text="文件" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Button
                            x:Name="AddFilesButton"
                            Content="添加媒体文件"
                            AutomationProperties.Name="添加媒体文件" />
                        <ListView x:Name="FileList" AutomationProperties.Name="文件列表" />
                    </StackPanel>
                </Border>

                <Frame
                    x:Name="WorkbenchFrame"
                    Grid.Row="0"
                    Grid.Column="1"
                    AutomationProperties.Name="中央预览区域" />

                <Border
                    x:Name="RightParameterPanel"
                    Grid.Row="0"
                    Grid.Column="2"
                    AutomationProperties.Name="参数区域">
                    <ScrollViewer>
                        <StackPanel x:Name="ParameterRegion" Spacing="8" Padding="10">
                            <TextBlock Text="参数" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ComboBox
                                x:Name="OutputFormat"
                                Header="输出格式"
                                AutomationProperties.Name="输出格式" />
                            <Button
                                x:Name="ExecuteButton"
                                Content="开始执行"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border
                    x:Name="TaskQueue"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    AutomationProperties.Name="任务队列区域">
                    <ListView
                        x:Name="TaskQueueList"
                        AutomationProperties.Name="任务队列列表" />
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
