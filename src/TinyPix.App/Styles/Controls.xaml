<?xml version="1.0" encoding="utf-8"?>
<!--
  Component styles for the TinyPix 4.0 shell, matching the Pencil component
  library (design/TinyPix-4.0.pen → Design System):
  Button/Primary · Button/Secondary · Button/Icon · Input/Select · Control/Switch
  · Card/File · Card/Preset · Navigation/ToolEntry · Shell regions.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Buttons ============ -->

    <!-- Button/Primary: action-primary surface filled page-to-page, lime label. -->
    <Style x:Key="TinyPixPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TinyPixActionPrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixOnActionPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Button/Secondary: surface + control-border, ink label. -->
    <Style x:Key="TinyPixSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Button/Ghost: text-only affordance (重置参数 / 管理预设). -->
    <Style x:Key="TinyPixGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Button/Danger -->
    <Style x:Key="TinyPixDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TinyPixDangerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixOnDangerBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixDangerBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Button/Icon: 44x44 hit target, transparent until hover. -->
    <Style x:Key="TinyPixIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Navigation/ToolEntry + left-panel shortcut rows: 40px, radius 10. -->
    <Style x:Key="TinyPixNavRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Mode pill (top nav segmented control). -->
    <Style x:Key="TinyPixModePillStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid
                        x:Name="PillRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource TinyPixLimeBrush}" />
                                        <Setter Target="PillLabel.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                        <Setter Target="PillRoot.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PillLabel.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid
                            x:Name="HoverLayer"
                            Background="{ThemeResource TinyPixSurfaceMutedBrush}"
                            CornerRadius="10"
                            Opacity="0" />
                        <TextBlock
                            x:Name="PillLabel"
                            Text="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Text ============ -->

    <Style x:Key="TinyPixPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
    </Style>

    <Style x:Key="TinyPixPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TinyPixSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
    </Style>

    <Style x:Key="TinyPixLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixMutedBrush}" />
    </Style>

    <Style x:Key="TinyPixValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
    </Style>

    <Style x:Key="TinyPixMetaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixMutedBrush}" />
    </Style>

    <Style x:Key="TinyPixMonoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixMonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixMutedBrush}" />
    </Style>

    <!-- ============ Surfaces ============ -->

    <!-- Panel surface: bordered region used by left/right/top/queue. -->
    <Style x:Key="TinyPixPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Card/File · Card/Preset container. -->
    <Style x:Key="TinyPixCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Muted inset card (file card, engine status, task row). -->
    <Style x:Key="TinyPixInsetCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Input/Select · Input/Text field shell. -->
    <Style x:Key="TinyPixFieldStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="13,0" />
    </Style>

    <Style x:Key="TinyPixDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource TinyPixDividerBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Accent chip (等待处理 badge / 完全离线 chip). -->
    <Style x:Key="TinyPixChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceMutedBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <!-- ============ Inputs ============ -->

    <!-- Flat select: native ComboBox restyled to the design's field shell. -->
    <Style x:Key="TinyPixComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceMutedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="TinyPixTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource TinyPixSurfaceMutedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TinyPixControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Quality slider: lime rail, ink knob (design: qualitySlider). -->
    <Style x:Key="TinyPixSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{ThemeResource TinyPixLimeBrush}" />
        <Setter Property="Background" Value="{ThemeResource TinyPixTrackBaseBrush}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="StepFrequency" Value="1" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
    </Style>

    <!-- Track switch (Control/Switch). -->
    <Style x:Key="TinyPixToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource TinyPixInkBrush}" />
        <Setter Property="FontFamily" Value="{ThemeResource TinyPixCjkFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- ============ Lists ============ -->

    <Style x:Key="TinyPixPlainListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="IsItemClickEnabled" Value="False" />
    </Style>

</ResourceDictionary>
