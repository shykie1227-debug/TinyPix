<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyPix.App.Pages.VideoOutputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TinyPix.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Template 1 / 视频输出 — design frame rUrqE: center preview + right 输出设置. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ================= Center / Preview ================= -->
        <Grid Grid.Column="0" Padding="20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:CenterHeaderControl
                Grid.Row="0"
                Title="视频输出"
                Subtitle="预览、调整参数并导出本地文件" />

            <controls:PreviewStageControl
                x:Name="Preview"
                Grid.Row="1"
                Glyph="&#xE768;"
                PreviewName="尚未添加文件"
                PreviewSpec="支持 MP4 / MOV / MKV / WebM" />

            <controls:PresetRowControl
                x:Name="Presets"
                Grid.Row="2"
                SectionTitle="常用预设" />

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="3"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                AutomationProperties.Name="输出状态" />
        </Grid>

        <!-- ================= Right / Output Settings ================= -->
        <Border
            Grid.Column="1"
            Width="300"
            Background="{ThemeResource TinyPixSurfaceBrush}"
            BorderBrush="{ThemeResource TinyPixBorderBrush}"
            BorderThickness="1,0,0,0">
            <Grid Padding="18" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock
                        Text="输出设置"
                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TinyPixInkBrush}"
                        VerticalAlignment="Center" />
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource TinyPixGhostButtonStyle}"
                        Content="重置参数"
                        Click="OnResetClick"
                        AutomationProperties.Name="重置参数" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="7">
                            <TextBlock Text="格式" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="FormatBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="输出格式">
                                <ComboBoxItem Content="MP4" />
                                <ComboBoxItem Content="MOV" />
                                <ComboBoxItem Content="MKV" />
                                <ComboBoxItem Content="AVI" />
                                <ComboBoxItem Content="WebM" />
                                <ComboBoxItem Content="MP3（仅音频）" />
                                <ComboBoxItem Content="WAV（仅音频）" />
                                <ComboBoxItem Content="AAC（仅音频）" />
                                <ComboBoxItem Content="FLAC（仅音频）" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="编码器" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="CodecBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="编码器">
                                <ComboBoxItem Content="H.264（兼容性最佳）" />
                                <ComboBoxItem Content="HEVC（体积更小）" />
                                <ComboBoxItem Content="VP9（网页优先）" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="分辨率" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="ResolutionBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="分辨率">
                                <ComboBoxItem Content="保持原始" />
                                <ComboBoxItem Content="1920 × 1080" />
                                <ComboBoxItem Content="1280 × 720" />
                                <ComboBoxItem Content="854 × 480" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <Grid>
                                <TextBlock Text="质量" Style="{StaticResource TinyPixLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="QualityValueText"
                                    Text="高 · CRF 18"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource TinyPixValueStyle}"
                                    FontSize="11" />
                            </Grid>
                            <Slider
                                x:Name="QualitySlider"
                                Style="{StaticResource TinyPixSliderStyle}"
                                Minimum="0"
                                Maximum="100"
                                Value="82"
                                AutomationProperties.Name="质量"
                                ValueChanged="OnQualityChanged" />
                            <Grid>
                                <TextBlock Text="更小文件" FontSize="9" Foreground="{ThemeResource TinyPixMutedBrush}" />
                                <TextBlock
                                    Text="更高质量"
                                    HorizontalAlignment="Right"
                                    FontSize="9"
                                    Foreground="{ThemeResource TinyPixMutedBrush}" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource TinyPixDividerStyle}" />

                        <Grid Height="54">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="硬件加速" Style="{StaticResource TinyPixValueStyle}" />
                                <TextBlock Text="自动选择可用设备" Style="{StaticResource TinyPixMetaStyle}" FontSize="9" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="HardwareSwitch"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsOn="True"
                                Style="{StaticResource TinyPixToggleSwitchStyle}"
                                AutomationProperties.Name="硬件加速" />
                        </Grid>

                        <StackPanel Spacing="7">
                            <TextBlock Text="输出目录" Style="{StaticResource TinyPixLabelStyle}" />
                            <Border Style="{StaticResource TinyPixFieldStyle}" Height="42">
                                <Grid>
                                    <TextBlock
                                        x:Name="OutputPathText"
                                        Text="与原文件相同"
                                        Style="{StaticResource TinyPixMonoStyle}"
                                        FontSize="10"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="浏览"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TinyPixMutedBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button
                    x:Name="StartOutputButton"
                    Grid.Row="2"
                    Height="48"
                    Style="{StaticResource TinyPixPrimaryButtonStyle}"
                    Click="StartOutputButton_Click"
                    AutomationProperties.Name="开始输出">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource TinyPixOnActionPrimaryBrush}" />
                        <TextBlock
                            Text="开始输出"
                            FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TinyPixOnActionPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
