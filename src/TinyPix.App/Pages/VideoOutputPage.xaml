<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyPix.App.Pages.VideoOutputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      视频工具 > 视频输出 — the default landing page (design/UI-SPEC.md) built on
      template 1 (conversion/compression workbench). Phase 1 wires the workbench to
      the video.convert handler through JobSubmissionService: add files, pick a
      format and quality, then enqueue. GIF / trim land in later phases.
    -->
    <Grid Padding="16">
        <StackPanel Spacing="12">
            <TextBlock
                Text="视频输出"
                Style="{ThemeResource TitleTextBlockStyle}"
                AutomationProperties.Name="视频输出" />

            <Border
                x:Name="PreviewStage"
                MinHeight="240"
                AutomationProperties.Name="中央预览区域">
                <TextBlock
                    Text="添加视频后在此预览"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <Button
                x:Name="AddFilesButton"
                Content="添加视频"
                AutomationProperties.Name="添加视频"
                Click="AddFilesButton_Click" />

            <ComboBox
                x:Name="FormatBox"
                Header="输出格式"
                AutomationProperties.Name="输出格式"
                SelectedIndex="0">
                <ComboBoxItem Content="MP4" />
                <ComboBoxItem Content="MOV" />
                <ComboBoxItem Content="MKV" />
                <ComboBoxItem Content="AVI" />
                <ComboBoxItem Content="WebM" />
                <ComboBoxItem Content="MP3（仅音频）" />
                <ComboBoxItem Content="WAV（仅音频）" />
                <ComboBoxItem Content="AAC（仅音频）" />
                <ComboBoxItem Content="FLAC（仅音频）" />
            </ComboBox>

            <Slider
                x:Name="QualitySlider"
                Header="质量"
                Minimum="0"
                Maximum="100"
                Value="80" />

            <Button
                x:Name="StartOutputButton"
                Content="开始输出"
                Style="{ThemeResource AccentButtonStyle}"
                AutomationProperties.Name="开始输出"
                Click="StartOutputButton_Click" />

            <TextBlock
                x:Name="StatusText"
                AutomationProperties.Name="输出状态"
                Foreground="{ThemeResource TinyPixMutedBrush}" />
        </StackPanel>
    </Grid>
</Page>
