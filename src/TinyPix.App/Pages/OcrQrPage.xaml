<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyPix.App.Pages.OcrQrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TinyPix.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Template 7 / OCR 与二维码识别 — design frame NIPNW. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ================= Center / Preview ================= -->
        <Grid Grid.Column="0" Padding="20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:CenterHeaderControl
                Grid.Row="0"
                Title="OCR 与二维码识别"
                Subtitle="离线识别图片、扫描 PDF、二维码与条形码" />

            <controls:PreviewStageControl
                x:Name="Preview"
                Grid.Row="1"
                Glyph="&#xE721;"
                PreviewName="尚未添加文件"
                PreviewSpec="支持 PNG / JPG / WebP / PDF" />

            <controls:PresetRowControl
                x:Name="Presets"
                Grid.Row="2"
                SectionTitle="识别模式" />

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="3"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                AutomationProperties.Name="识别状态" />
        </Grid>

        <!-- ================= Right / Recognition Settings ================= -->
        <Border
            Grid.Column="1"
            Width="300"
            Background="{ThemeResource TinyPixSurfaceBrush}"
            BorderBrush="{ThemeResource TinyPixBorderBrush}"
            BorderThickness="1,0,0,0">
            <Grid Padding="18" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock
                        Text="识别设置"
                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TinyPixInkBrush}"
                        VerticalAlignment="Center" />
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource TinyPixGhostButtonStyle}"
                        Content="重置参数"
                        Click="OnResetClick"
                        AutomationProperties.Name="重置参数" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="7">
                            <TextBlock Text="识别类型" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="KindBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="0"
                                SelectionChanged="OnKindChanged"
                                AutomationProperties.Name="识别类型">
                                <ComboBoxItem Content="二维码 / 条码" Tag="code.scan" />
                                <ComboBoxItem Content="图片 OCR 文本" Tag="ocr.image" />
                                <ComboBoxItem Content="扫描 PDF OCR" Tag="ocr.pdf" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="语言" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="LanguageBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="识别语言">
                                <ComboBoxItem Content="简体中文 + English" Tag="chi_sim+eng" />
                                <ComboBoxItem Content="English" Tag="eng" />
                                <ComboBoxItem Content="繁體中文" Tag="chi_tra" />
                                <ComboBoxItem Content="日本語" Tag="jpn" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="页面范围" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="PagesBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="页面范围">
                                <ComboBoxItem Content="全部页面" Tag="" />
                                <ComboBoxItem Content="第 1 页" Tag="1" />
                                <ComboBoxItem Content="1-5 页" Tag="1-5" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <Grid>
                                <TextBlock Text="版面" Style="{StaticResource TinyPixLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="LayoutValueText"
                                    Text="保留段落顺序"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource TinyPixValueStyle}"
                                    FontSize="11" />
                            </Grid>
                            <Slider
                                x:Name="LayoutSlider"
                                Style="{StaticResource TinyPixSliderStyle}"
                                Minimum="0"
                                Maximum="100"
                                Value="74"
                                AutomationProperties.Name="版面还原"
                                ValueChanged="OnLayoutChanged" />
                            <Grid>
                                <TextBlock Text="纯文本" FontSize="9" Foreground="{ThemeResource TinyPixMutedBrush}" />
                                <TextBlock
                                    Text="保留版面"
                                    HorizontalAlignment="Right"
                                    FontSize="9"
                                    Foreground="{ThemeResource TinyPixMutedBrush}" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource TinyPixDividerStyle}" />

                        <Grid Height="54">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="硬件加速" Style="{StaticResource TinyPixValueStyle}" />
                                <TextBlock Text="自动选择可用设备" Style="{StaticResource TinyPixMetaStyle}" FontSize="9" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="HardwareSwitch"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsOn="True"
                                Style="{StaticResource TinyPixToggleSwitchStyle}"
                                AutomationProperties.Name="硬件加速" />
                        </Grid>

                        <StackPanel Spacing="7">
                            <TextBlock Text="输出目录" Style="{StaticResource TinyPixLabelStyle}" />
                            <Border Style="{StaticResource TinyPixFieldStyle}" Height="42">
                                <Grid>
                                    <TextBlock
                                        x:Name="OutputPathText"
                                        Text="与原文件相同"
                                        Style="{StaticResource TinyPixMonoStyle}"
                                        FontSize="10"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        Margin="0,0,42,0" />
                                    <TextBlock
                                        Text="浏览"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TinyPixMutedBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button
                    x:Name="StartButton"
                    Grid.Row="2"
                    Height="48"
                    Style="{StaticResource TinyPixPrimaryButtonStyle}"
                    Click="StartButton_Click"
                    AutomationProperties.Name="开始识别">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TinyPixOnActionPrimaryBrush}" />
                        <TextBlock
                            Text="开始识别"
                            FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TinyPixOnActionPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
