<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyPix.App.Pages.ImageWorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      图片工作台 (image) — Phase 3. One page hosts all eleven frozen image tools
      (design/FEATURE-MATRIX §4): a tool list on the left, a declaratively
      rendered parameter form for the selected tool, the shared add-files flow
      and the JobSubmissionService submit path used by every other workbench.
    -->
    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tool list (eleven frozen ids). -->
        <Border
            Grid.Column="0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Text="图片工具"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    AutomationProperties.Name="图片工具列表" />
                <ListView
                    x:Name="ToolList"
                    Grid.Row="1"
                    AutomationProperties.Name="工具列表"
                    DisplayMemberPath="Title"
                    SelectionChanged="ToolList_SelectionChanged" />
            </Grid>
        </Border>

        <!-- Workbench: preview placeholder + form + submit. -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Name="ToolTitle"
                    Text="图片工作台"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    AutomationProperties.Name="工具标题" />

                <TextBlock
                    x:Name="ToolHint"
                    Text="从左侧选择一个图片工具。"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TinyPixMutedBrush}"
                    AutomationProperties.Name="工具说明" />

                <Border
                    x:Name="PreviewStage"
                    MinHeight="180"
                    AutomationProperties.Name="中央预览区域">
                    <TextBlock
                        Text="添加图片后在此预览"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AddFilesButton"
                        Content="添加图片"
                        AutomationProperties.Name="添加图片"
                        Click="AddFilesButton_Click" />
                    <Button
                        x:Name="ClearFilesButton"
                        Content="清空列表"
                        AutomationProperties.Name="清空列表"
                        Click="ClearFilesButton_Click" />
                    <TextBlock
                        x:Name="FileCountText"
                        VerticalAlignment="Center"
                        Text="0 张图片"
                        AutomationProperties.Name="已添加图片数量" />
                </StackPanel>

                <!-- Parameter form is generated from the frozen tool schema. -->
                <StackPanel
                    x:Name="FormHost"
                    Spacing="10"
                    AutomationProperties.Name="参数表单" />

                <Button
                    x:Name="StartButton"
                    Content="开始处理"
                    Style="{ThemeResource AccentButtonStyle}"
                    AutomationProperties.Name="开始处理"
                    Click="StartButton_Click" />

                <TextBlock
                    x:Name="StatusText"
                    TextWrapping="Wrap"
                    AutomationProperties.Name="处理状态"
                    Foreground="{ThemeResource TinyPixMutedBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
