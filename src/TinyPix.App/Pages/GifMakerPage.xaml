<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyPix.App.Pages.GifMakerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      GIF 制作业务页 (video.gif) — Phase 2. Built on the Timeline template workbench.
      Adds the GIF-specific parameters (开始/结束时间、帧率、尺寸、循环、质量) on top of
      the shared file-add / preview / submit shell used by 视频输出.
    -->
    <Grid Padding="16">
        <ScrollViewer>
            <StackPanel Spacing="12">
                <TextBlock
                    Text="GIF 制作"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    AutomationProperties.Name="GIF 制作" />

                <Border
                    x:Name="PreviewStage"
                    MinHeight="240"
                    AutomationProperties.Name="中央预览区域">
                    <TextBlock
                        Text="添加视频后在此预览 GIF"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <Button
                    x:Name="AddFilesButton"
                    Content="添加视频"
                    AutomationProperties.Name="添加视频"
                    Click="AddFilesButton_Click" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <NumberBox
                        x:Name="StartTimeBox"
                        Grid.Column="0"
                        Header="开始时间 (秒)"
                        Minimum="0"
                        Value="0"
                        AutomationProperties.Name="开始时间" />
                    <NumberBox
                        x:Name="EndTimeBox"
                        Grid.Column="1"
                        Header="结束时间 (秒)"
                        Minimum="0"
                        Value="5"
                        AutomationProperties.Name="结束时间" />
                </Grid>

                <ComboBox
                    x:Name="FpsBox"
                    Header="帧率 (FPS)"
                    AutomationProperties.Name="帧率 (FPS)"
                    SelectedIndex="1">
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="15" />
                    <ComboBoxItem Content="24" />
                </ComboBox>

                <ComboBox
                    x:Name="SizeBox"
                    Header="GIF 尺寸"
                    AutomationProperties.Name="GIF 尺寸"
                    SelectedIndex="2">
                    <ComboBoxItem Content="原始" />
                    <ComboBoxItem Content="320P" />
                    <ComboBoxItem Content="480P" />
                    <ComboBoxItem Content="640P" />
                    <ComboBoxItem Content="720P" />
                </ComboBox>

                <ComboBox
                    x:Name="LoopBox"
                    Header="循环次数"
                    AutomationProperties.Name="循环次数"
                    SelectedIndex="0">
                    <ComboBoxItem Content="无限循环" />
                    <ComboBoxItem Content="1 次" />
                    <ComboBoxItem Content="3 次" />
                </ComboBox>

                <Slider
                    x:Name="QualitySlider"
                    Header="输出质量"
                    Minimum="0"
                    Maximum="100"
                    Value="80"
                    AutomationProperties.Name="输出质量" />

                <Button
                    x:Name="StartOutputButton"
                    Content="开始制作"
                    Style="{ThemeResource AccentButtonStyle}"
                    AutomationProperties.Name="开始制作"
                    Click="StartOutputButton_Click" />

                <TextBlock
                    x:Name="StatusText"
                    AutomationProperties.Name="输出状态"
                    Foreground="{ThemeResource TinyPixMutedBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
