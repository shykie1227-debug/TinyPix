<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TinyPix.App.Pages.GifMakerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TinyPix.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Key Page / GIF 制作 — design frame SeIGS. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:CenterHeaderControl
                Grid.Row="0"
                Title="GIF 制作"
                Subtitle="选择片段、尺寸、帧率、循环与质量" />

            <controls:PreviewStageControl
                x:Name="Preview"
                Grid.Row="1"
                Glyph="&#xE768;"
                PreviewName="尚未添加文件"
                PreviewSpec="GIF 最长 30 秒" />

            <controls:PresetRowControl
                x:Name="Presets"
                Grid.Row="2"
                SectionTitle="常用预设" />

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="3"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                AutomationProperties.Name="GIF 状态" />
        </Grid>

        <Border
            Grid.Column="1"
            Width="300"
            Background="{ThemeResource TinyPixSurfaceBrush}"
            BorderBrush="{ThemeResource TinyPixBorderBrush}"
            BorderThickness="1,0,0,0">
            <Grid Padding="18" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock
                        Text="GIF 参数"
                        FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TinyPixInkBrush}"
                        VerticalAlignment="Center" />
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource TinyPixGhostButtonStyle}"
                        Content="重置参数"
                        Click="OnResetClick"
                        AutomationProperties.Name="重置参数" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="7">
                            <TextBlock Text="时间范围（秒）" Style="{StaticResource TinyPixLabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="StartTimeBox"
                                    Grid.Column="0"
                                    Header="开始"
                                    Value="0"
                                    Minimum="0"
                                    Maximum="3600"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="开始时间" />
                                <NumberBox
                                    x:Name="EndTimeBox"
                                    Grid.Column="1"
                                    Header="结束"
                                    Value="5"
                                    Minimum="0"
                                    Maximum="3600"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="结束时间" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="尺寸" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="SizeBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="1"
                                AutomationProperties.Name="GIF 尺寸">
                                <ComboBoxItem Content="原始" />
                                <ComboBoxItem Content="480P" />
                                <ComboBoxItem Content="640P" />
                                <ComboBoxItem Content="720P" />
                                <ComboBoxItem Content="320P" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="帧率" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="FpsBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="帧率">
                                <ComboBoxItem Content="12" />
                                <ComboBoxItem Content="15" />
                                <ComboBoxItem Content="20" />
                                <ComboBoxItem Content="24" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="循环次数" Style="{StaticResource TinyPixLabelStyle}" />
                            <ComboBox
                                x:Name="LoopBox"
                                Style="{StaticResource TinyPixComboBoxStyle}"
                                SelectedIndex="0"
                                AutomationProperties.Name="循环次数">
                                <ComboBoxItem Content="无限循环" />
                                <ComboBoxItem Content="1 次" />
                                <ComboBoxItem Content="3 次" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <Grid>
                                <TextBlock Text="质量" Style="{StaticResource TinyPixLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="QualityValueText"
                                    Text="高 · 调色板优化"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource TinyPixValueStyle}"
                                    FontSize="11" />
                            </Grid>
                            <Slider
                                x:Name="QualitySlider"
                                Style="{StaticResource TinyPixSliderStyle}"
                                Minimum="0"
                                Maximum="100"
                                Value="80"
                                AutomationProperties.Name="质量"
                                ValueChanged="OnQualityChanged" />
                            <Grid>
                                <TextBlock Text="更小文件" FontSize="9" Foreground="{ThemeResource TinyPixMutedBrush}" />
                                <TextBlock
                                    Text="更高质量"
                                    HorizontalAlignment="Right"
                                    FontSize="9"
                                    Foreground="{ThemeResource TinyPixMutedBrush}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button
                    x:Name="StartOutputButton"
                    Grid.Row="2"
                    Height="48"
                    Style="{StaticResource TinyPixPrimaryButtonStyle}"
                    Click="StartOutputButton_Click"
                    AutomationProperties.Name="生成 GIF">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{ThemeResource TinyPixOnActionPrimaryBrush}" />
                        <TextBlock
                            Text="生成 GIF"
                            FontFamily="{ThemeResource TinyPixCjkFontFamily}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TinyPixOnActionPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
